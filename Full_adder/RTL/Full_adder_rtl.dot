digraph "Full_adder" {
label="Full_adder";
rankdir="LR";
remincross=true;
n2 [ shape=diamond, label="a", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="b", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="cin", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="cout", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="key_a", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="key_b", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="key_cin", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="led_cout", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="led_s", color="black", fontcolor="black" ];
n11 [ shape=diamond, label="s", color="black", fontcolor="black" ];
c15 [ shape=record, label="{{<p12> A|<p13> B}|$4\n$add|{<p14> Y}}",  ];
c16 [ shape=record, label="{{<p12> A|<p13> B}|$5\n$add|{<p14> Y}}",  ];
x0 [ shape=record, style=rounded, label="<s1> 1:1 - 0:0 |<s0> 0:0 - 0:0 ", color="black", fontcolor="black" ];
c16:p14:e -> x0:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c17 [ shape=record, label="{{<p12> A}|$1\n$not|{<p14> Y}}",  ];
c18 [ shape=record, label="{{<p12> A}|$2\n$not|{<p14> Y}}",  ];
c19 [ shape=record, label="{{<p12> A}|$3\n$not|{<p14> Y}}",  ];
c20 [ shape=record, label="{{<p12> A}|$6\n$not|{<p14> Y}}",  ];
c21 [ shape=record, label="{{<p12> A}|$7\n$not|{<p14> Y}}",  ];
c15:p14:e -> c16:p12:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c20:p14:e -> n10:w [color="black", fontcolor="black", label=""];
x0:s0:e -> n11:w [color="black", fontcolor="black", label=""];
n11:e -> c20:p12:w [color="black", fontcolor="black", label=""];
c17:p14:e -> n2:w [color="black", fontcolor="black", label=""];
n2:e -> c15:p12:w [color="black", fontcolor="black", label=""];
c18:p14:e -> n3:w [color="black", fontcolor="black", label=""];
n3:e -> c15:p13:w [color="black", fontcolor="black", label=""];
c19:p14:e -> n4:w [color="black", fontcolor="black", label=""];
n4:e -> c16:p13:w [color="black", fontcolor="black", label=""];
x0:s1:e -> n5:w [color="black", fontcolor="black", label=""];
n5:e -> c21:p12:w [color="black", fontcolor="black", label=""];
n6:e -> c17:p12:w [color="black", fontcolor="black", label=""];
n7:e -> c18:p12:w [color="black", fontcolor="black", label=""];
n8:e -> c19:p12:w [color="black", fontcolor="black", label=""];
c21:p14:e -> n9:w [color="black", fontcolor="black", label=""];
}
