#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x62c818db30f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x62c818db3280 .scope module, "counter_tb" "counter_tb" 3 3;
 .timescale -9 -12;
P_0x62c818d788c0 .param/l "SIM_CNT_MAX" 1 3 10, C4<0000000000000000000000101>;
v0x62c818dc6a60_0 .net "led_out", 0 0, v0x62c818dc6790_0;  1 drivers
v0x62c818dc6b30_0 .var "sys_clk", 0 0;
v0x62c818dc6c00_0 .var "sys_rst_n", 0 0;
S_0x62c818d77cf0 .scope module, "u_counter" "counter" 3 15, 4 3 0, S_0x62c818db3280;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "sys_clk";
    .port_info 1 /INPUT 1 "sys_rst_n";
    .port_info 2 /OUTPUT 1 "led_out";
P_0x62c818d77ed0 .param/l "CNT_MAX" 0 4 4, C4<0000000000000000000000101>;
v0x62c818d78010_0 .var "cnt", 24 0;
v0x62c818dc6790_0 .var "led_out", 0 0;
v0x62c818dc6850_0 .net "sys_clk", 0 0, v0x62c818dc6b30_0;  1 drivers
v0x62c818dc6920_0 .net "sys_rst_n", 0 0, v0x62c818dc6c00_0;  1 drivers
E_0x62c818d78230/0 .event negedge, v0x62c818dc6920_0;
E_0x62c818d78230/1 .event posedge, v0x62c818dc6850_0;
E_0x62c818d78230 .event/or E_0x62c818d78230/0, E_0x62c818d78230/1;
    .scope S_0x62c818d77cf0;
T_0 ;
    %wait E_0x62c818d78230;
    %load/vec4 v0x62c818dc6920_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 25;
    %assign/vec4 v0x62c818d78010_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x62c818dc6790_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x62c818d78010_0;
    %cmpi/e 5, 0, 25;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 25;
    %assign/vec4 v0x62c818d78010_0, 0;
    %load/vec4 v0x62c818dc6790_0;
    %inv;
    %assign/vec4 v0x62c818dc6790_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x62c818d78010_0;
    %addi 1, 0, 25;
    %assign/vec4 v0x62c818d78010_0, 0;
    %load/vec4 v0x62c818dc6790_0;
    %assign/vec4 v0x62c818dc6790_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x62c818db3280;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62c818dc6b30_0, 0, 1;
T_1.0 ;
    %delay 10000, 0;
    %load/vec4 v0x62c818dc6b30_0;
    %inv;
    %store/vec4 v0x62c818dc6b30_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x62c818db3280;
T_2 ;
    %vpi_call/w 3 29 "$dumpfile", "sim-wave/counter.vcd" {0 0 0};
    %vpi_call/w 3 30 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62c818db3280 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62c818dc6c00_0, 0, 1;
    %delay 40000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62c818dc6c00_0, 0, 1;
    %delay 300000, 0;
    %delay 15000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62c818dc6c00_0, 0, 1;
    %delay 30000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62c818dc6c00_0, 0, 1;
    %delay 200000, 0;
    %vpi_call/w 3 51 "$display", "Simulation finished successfully." {0 0 0};
    %vpi_call/w 3 52 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "sim-wave/counter_tb.v";
    "RTL/counter.v";
